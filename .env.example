# ==============================================================================
# AgriLens Environment Variables Example
# 2026 NISR Big Data Hackathon – Track 1: Agricultural Productivity
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-agrilens-rwanda-2026
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SETTINGS_MODULE=config.settings

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_URL=postgres://agrilens_user:secret_password@localhost:5432/agrilens_db


# Timezone & Localization (Rwanda Standard Time)
TIME_ZONE=Africa/Kigali
LANGUAGE_CODE=en-us

# Background Processing & Cache (Celery / Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional Monitoring / External Services
# SENTRY_DSN=
